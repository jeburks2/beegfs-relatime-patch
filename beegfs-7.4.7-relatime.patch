 }
+
+/**
+ * Check if atime should be updated according to relatime semantics.
+ *
+ * @param inode the inode to check
+ * @param relatimeSecs threshold in seconds (0 = disabled)
+ * @return true if atime should be updated
+ */
+bool __FhgfsOpsHelper_shouldUpdateAtime(struct inode* inode, unsigned relatimeSecs)
+{
+   Time now, atime, mtime, ctime;
+   long long atime_age_secs;
+
+   if (relatimeSecs == 0)
+      return false; // relatime disabled
+
+   Time_setToNowReal(&now);
+   atime.tv_sec = inode_get_atime_sec(inode);
+   atime.tv_nsec = inode_get_atime_nsec(inode);
+   mtime.tv_sec = inode_get_mtime_sec(inode);
+   mtime.tv_nsec = inode_get_mtime_nsec(inode);
+   ctime.tv_sec = inode_get_ctime_sec(inode);
+   ctime.tv_nsec = inode_get_ctime_nsec(inode);
+
+   // Always update if atime < mtime or atime < ctime (file was modified)
+   if (Time_compare(&atime, &mtime) < 0 || Time_compare(&atime, &ctime) < 0)
+      return true;
+
+   // Update if atime is older than threshold
+   atime_age_secs = now.tv_sec - atime.tv_sec;
+   return (atime_age_secs >= relatimeSecs);
+}
+
+/**
+ * Update atime for an inode using best-effort approach.
+ * This function performs the actual metadata server communication.
+ *
+ * @param app application context
+ * @param inode the inode to update
+ * @param fhgfsInode the BeeGFS inode (for entryInfo locking)
+ */
+void __FhgfsOpsHelper_updateAtime(App* app, struct inode* inode, FhgfsInode* fhgfsInode)
+{
+   Logger* log = App_getLogger(app);
+   const char* logContext = "__FhgfsOpsHelper_updateAtime";
+   FhgfsOpsErr setAttrRes;
+   SettableFileAttribs settableAttribs;
+   Time now;
+   int validAttribs;
+
+   // Prepare new atime
+   Time_setToNowReal(&now);
+
+   // Initialize settable attributes for atime only
+   memset(&settableAttribs, 0, sizeof(settableAttribs));
+   settableAttribs.lastAccessTimeSecs = now.tv_sec;
+
+   // Set only atime flag
+   validAttribs = SETATTR_CHANGE_LASTACCESSTIME;
+
+   FhgfsInode_entryInfoReadLock(fhgfsInode); // LOCK EntryInfo
+
+   // Update on metadata server (best effort)
+   setAttrRes = FhgfsOpsRemoting_setAttr(app, FhgfsInode_getEntryInfo(fhgfsInode),
+      &settableAttribs, validAttribs, NULL);
+
+   FhgfsInode_entryInfoReadUnlock(fhgfsInode); // UNLOCK EntryInfo
+
+   if (likely(setAttrRes == FhgfsOpsErr_SUCCESS))
+   {
+      // Update local inode cache on success
+      inode_set_atime(inode, now.tv_sec, now.tv_nsec);
+
+      if (unlikely(Logger_getLogLevel(log) >= Log_SPAM))
+         FhgfsOpsHelper_logOpMsg(Log_SPAM, app, NULL, inode, logContext, "Updated atime to %lld", (long long)now.tv_sec);
+
+   }
+   // Note: We don't handle errors - this is best effort and shouldn't fail reads
+}
